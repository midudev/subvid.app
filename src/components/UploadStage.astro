---
import DropzoneIcon from "@/assets/svg/dropzone.svg"
import Footer from "@/components/Footer.astro"
import HomeDemo from "@/components/HomeDemo.astro"
import Steps from "@/components/Steps.astro"
import { useTranslations } from "@/i18n/ui"

const t = useTranslations(Astro.currentLocale)
// Each word gets its own index so the title "plays" like a word-by-word caption.
const titleWords = t.hero.title.split(" ")
// One-click sample clips (public/demos): same order as `t.hero.samples`.
const samples = [
  { id: "space", lang: "EN", duration: "0:08" },
  { id: "iss", lang: "ES", duration: "0:09" },
  { id: "orbit", lang: "EN", duration: "0:09" },
]
---

<section id="stage-upload" class="stage-upload">
  <div class="upload-intro">
    <div class="hero">
      <h1 class="hero-title">
        {
          titleWords.map((word, index) => (
            <>
              {index > 0 && " "}
              <span class="hero-word" style={`--i:${index}`}>
                {word}
              </span>
            </>
          ))
        }
      </h1>
      <p class="hero-sub">{t.hero.sub}</p>
    </div>

    <div
      id="dropzone"
      class="dropzone"
      role="button"
      tabindex="0"
      data-default-label={t.hero.dropLabel}
      data-default-hint={t.hero.dropHint}
      data-unsupported-label={t.hero.dropUnsupportedLabel}
      data-unsupported-hint={t.hero.dropUnsupportedHint}
    >
      <input id="video-input" type="file" accept="video/*,audio/*" hidden />
      <DropzoneIcon class="dz-icon" />
      <strong id="dropzone-label" class="dz-label">{t.hero.dropLabel}</strong>
      <span class="dz-button">{t.hero.dropButton}</span>
      <span id="dropzone-hint" class="dz-hint" aria-live="polite">
        {t.hero.dropHint}
      </span>
    </div>

    <div class="samples">
      <p class="samples-head">
        <span>{t.hero.samplesLabel}</span>
        <span class="samples-credit">{t.hero.samplesCredit}</span>
      </p>
      <ul class="samples-list">
        {
          samples.map((sample, index) => (
            <li>
              <button
                type="button"
                class="sample"
                data-sample={`/demos/${sample.id}.mp4`}
              >
                <span class="sample-thumb">
                  <img
                    src={`/demos/${sample.id}.webp`}
                    alt=""
                    width="480"
                    height="270"
                    decoding="async"
                  />
                  <span class="sample-time">{sample.lang} · {sample.duration}</span>
                </span>
                <span class="sample-title">{t.hero.samples[index]}</span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="upload-demo">
    <HomeDemo />
    <Steps demo />
  </div>

  <Footer />
</section>
